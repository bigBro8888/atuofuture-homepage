# 业务训练后端地址，配置后对话将转发到真实 API
# VITE_AGENT_API_URL=http://localhost:3000/api/agent/chat

# App 下载与管理 API
PORT=8787
HOST=127.0.0.1
PUBLIC_BASE_URL=https://www.atuofuture.com
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=admin@atuofuture.com
ADMIN_PASSWORD=replace-with-a-strong-initial-password
VERSION_SOURCE_URL=https://file.atuofuture.com/release/version
RELEASE_BASE_URL=https://file.atuofuture.com/release
VERSION_CACHE_MS=120000

# 阿里云 OSS（后台发布 Android 版本时必填）
OSS_REGION=oss-cn-hangzhou
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
# 自定义域名场景可选
# OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com

# 生产数据库建议按 server/migrations 建表；开发环境默认使用本地 JSON 数据。
# DATABASE_URL=postgresql://user:password@localhost:5432/atuofuture
# REDIS_URL=redis://localhost:6379
